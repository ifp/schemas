{
  "$schema": "http://iglucentral.com/schemas/com.snowplowanalytics.self-desc/schema/jsonschema/1-0-0#",
  "title": "IFP Simplified Export JSON Advert Schema",
  "description": "The simplified export JSON schema of property adverts within the IFP systems. Currently supports sale properties only. We use this schema to send you property adverts",
  "self": {
    "vendor": "com.french-property.schemas.json",
    "name": "simplified_export_sale-advert-schema",
    "format": "jsonschema",
    "version": "1-0-0"
  },
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "reference": {
      "type": [
        "null",
        "string"
      ]
    },
    "title_en": {
      "type": "string",
      "minLength": 3
    },
    "description_en": {
      "type": "string",
      "minLength": 3
    },
    "department_code": {
      "type": [
        "null",
        "string"
      ]
    },
    "post_code": {
      "type": [
        "null",
        "string"
      ]
    },
    "commune_name": {
      "type": [
        "null",
        "string"
      ]
    },
    "location": {
      "type": [
        "null",
        "string"
      ]
    },
    "price_eur": {
      "type": "number"
    },
    "bathrooms": {
      "type": [
        "integer",
        "null"
      ]
    },
    "bedrooms": {
      "type": [
        "integer",
        "null"
      ]
    },
    "floor_size_m2": {
      "type": [
        "null",
        "number"
      ]
    },
    "land_size_m2": {
      "type": [
        "null",
        "number"
      ]
    },
    "dpe_number": {
      "type": [
        "null",
        "number"
      ]
    },
    "ges_number": {
      "type": [
        "null",
        "number"
      ]
    },
    "attributes": {
      "type": "object",
      "description": "Lookup values describing the property. Deliberately not a closed enum: the internal vocabulary these are drawn from currently accepts any string, so this schema cannot promise a fixed set without rejecting our own output. The values in use are published at json/public/examples/public_sale-advert-schema_v1.x-enum-values.json.",
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "types",
        "features",
        "tags"
      ],
      "additionalProperties": false
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "url"
        ],
        "additionalProperties": true
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "reference",
    "title_en",
    "description_en",
    "department_code",
    "post_code",
    "commune_name",
    "location",
    "price_eur",
    "bathrooms",
    "bedrooms",
    "floor_size_m2",
    "land_size_m2",
    "dpe_number",
    "ges_number",
    "attributes",
    "images"
  ],
  "additionalProperties": false
}
